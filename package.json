{
  "name": "medai-nexus-jelas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "test:browser": "npm run build && node tests/browser-smoke.mjs",
    "data:synthetic": "node scripts/generate-synthetic.mjs",
    "model:train": "python tools/train_quality_model.py",
    "test:model": "python -m unittest discover -s tests -p test_quality_training.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3"
  }
}
